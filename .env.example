# Twister Crepes & Pizza — local environment template.
# Copy to `.env.local` and fill real values before deploying. Nothing here is a secret by
# default; ADMIN_PASSWORD must be set to a real value outside version control.

# Public site origin, used for canonical/OG metadata.
NEXT_PUBLIC_SITE_URL=https://twister.example

# WhatsApp order target (docs/product/whatsapp-order-message.md). Default is the number from
# the original brief — confirm with the restaurant owner before go-live (business-facts.md).
NEXT_PUBLIC_WHATSAPP_NUMBER=201233326848

# Local-sandbox admin panel password (docs/product/admin-requirements.md). Single shared
# password, HMAC-signed httpOnly cookie — not sufficient security for real sensitive data.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too
