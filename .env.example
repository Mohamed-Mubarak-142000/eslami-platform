# Al-Manara — local environment template. Copy to `.env.local` if you need to override defaults.
# Nothing in this template is a secret; real keys go in .env.local (git-ignored).

# Public site origin, used for canonical URLs, Open Graph metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://al-manara.example

# Optional: override the live Quran radio stream (defaults to Egyptian Quran Radio, Cairo).
# NEXT_PUBLIC_QURAN_RADIO_URL=

# Accounts (Supabase). Without these the site runs in on-device guest mode.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only service key — put it in .env.local only, never prefix with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=sb_secret_...
# Shows "Continue with Facebook" — set to 1 only after enabling the Facebook provider in Supabase.
# NEXT_PUBLIC_FACEBOOK_LOGIN=1

# Email codes (OTP) are sent by the app itself over SMTP — Gmail with an App Password works.
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# Optional: SMTP_HOST (default smtp.gmail.com), SMTP_PORT (default 465, implicit TLS), MAIL_FROM_NAME.
# Optional: OTP_SECRET — HMAC key for stored codes (defaults to SUPABASE_SECRET_KEY).

# Special-day reminder emails (Friday & al-Kahf, fasting days, seasons) are sent by
# POST /api/cron/reminders, called by .github/workflows/reminders.yml. Use a long random string,
# and set the same value as the CRON_SECRET secret in the GitHub repository.
# CRON_SECRET=
